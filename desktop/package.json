{
  "name": "soundwave",
  "productName": "Soundwave",
  "version": "1.1.0",
  "description": "SoundWave - odtwarzacz muzyki",
  "main": "main.js",
  "homepage": "https://muzyka.komodaoskara.pl",
  "author": {
    "name": "Oskar",
    "email": "oskar@example.com"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@xhayper/discord-rpc": "1.3.4"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.soundwave.app",
    "productName": "Soundwave",
    "copyright": "Copyright © Oskar",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "soundwave.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "SoundWave-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoundWave",
      "uninstallDisplayName": "SoundWave",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "1045",
      "installerLanguages": ["pl_PL"],
      "multiLanguageInstaller": false
    },
    "linux": {
      "icon": "soundwave.png",
      "target": ["rpm"],
      "category": "Audio",
      "maintainer": "Oskar <oskar@example.com>",
      "synopsis": "Odtwarzacz muzyki SoundWave"
    }
  }
}
